
/* ═══════════════════════════════════════════════════════════
   FANI · Centro de Control Numérico
   Paleta: #090d1a fondo | #00d4ff cyan | #7b2fff púrpura
           #ff6b35 naranja alerta | #0f1628 cards
   ═══════════════════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:       #090d1a;
  --bg2:      #0f1628;
  --bg3:      #162035;
  --cyan:     #00d4ff;
  --purple:   #7b2fff;
  --orange:   #ff6b35;
  --green:    #00ff9d;
  --text:     #c8d8f0;
  --text-dim: #5a7090;
  --border:   #1e2e4a;
  --font-ui:  'Space Grotesk', sans-serif;
  --font-mono:'Space Mono', monospace;
  --radius:   6px;
  --glow-c:   0 0 18px rgba(0,212,255,.35);
  --glow-p:   0 0 18px rgba(123,47,255,.35);
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-ui);
  font-size: 14px;
  line-height: 1.6;
  min-height: 100vh;
}

/* ── SCROLLBAR ── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(--bg2); }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

/* ═══════════════ HEADER ═══════════════ */
.site-header {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 28px 40px;
  background: linear-gradient(135deg, #0b1120 0%, #0f1a30 50%, #0b0e1c 100%);
  border-bottom: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}

.site-header::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 60% 80% at 10% 50%, rgba(0,212,255,.07) 0%, transparent 70%);
  pointer-events: none;
}

.radar-wrap {
  flex-shrink: 0;
  filter: drop-shadow(0 0 12px rgba(0,212,255,.5));
}

.header-text .eyebrow {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 4px;
}

.header-text h1 {
  font-size: clamp(22px, 4vw, 36px);
  font-weight: 700;
  letter-spacing: -.5px;
  background: linear-gradient(90deg, #fff 0%, var(--cyan) 60%, var(--purple) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.1;
}

.header-text .subtitle {
  color: var(--text-dim);
  font-size: 13px;
  margin-top: 4px;
}

/* ═══════════════ TABS ═══════════════ */
.tab-nav {
  display: flex;
  gap: 2px;
  padding: 8px 40px;
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
  overflow-x: auto;
  scrollbar-width: none;
}
.tab-nav::-webkit-scrollbar { display: none; }

.tab-btn {
  padding: 7px 14px;
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .05em;
  cursor: pointer;
  border-radius: var(--radius);
  white-space: nowrap;
  transition: all .2s;
}
.tab-btn:hover { color: var(--text); border-color: var(--border); }
.tab-btn.active {
  background: rgba(0,212,255,.1);
  border-color: var(--cyan);
  color: var(--cyan);
  box-shadow: var(--glow-c);
}

/* ═══════════════ CONTAINER ═══════════════ */
.container { max-width: 1200px; margin: 0 auto; padding: 32px 24px; }

.tab-panel { display: none; }
.tab-panel.active { display: block; animation: fadeIn .3s ease; }
@keyframes fadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }

/* ═══════════════ PANEL HEADER ═══════════════ */
.panel-header { margin-bottom: 24px; }

.badge {
  display: inline-block;
  padding: 2px 10px;
  background: rgba(123,47,255,.2);
  border: 1px solid var(--purple);
  color: #b48fff;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .12em;
  text-transform: uppercase;
  border-radius: 20px;
  margin-bottom: 8px;
}

.panel-header h2 {
  font-size: clamp(18px, 2.5vw, 24px);
  font-weight: 600;
  color: #fff;
  margin-bottom: 6px;
}

.panel-header .desc {
  color: var(--text-dim);
  font-size: 13px;
  max-width: 720px;
}

/* ═══════════════ GRID ═══════════════ */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
@media (max-width: 780px) { .grid-2 { grid-template-columns: 1fr; } }

/* ═══════════════ CARDS ═══════════════ */
.card {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 20px;
}
.card h3 {
  font-size: 13px;
  font-weight: 600;
  color: var(--cyan);
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}
.mt { margin-top: 20px; }
.mt-sm { margin-top: 10px; }

/* ═══════════════ FORM ELEMENTS ═══════════════ */
label {
  display: block;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-dim);
  letter-spacing: .06em;
  margin: 10px 0 4px;
}
.hint { font-size: 12px; color: var(--text-dim); margin-bottom: 8px; }

input[type="number"],
input[type="text"],
textarea,
select {
  width: 100%;
  background: var(--bg3);
  border: 1px solid var(--border);
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 12px;
  padding: 7px 10px;
  border-radius: var(--radius);
  outline: none;
  transition: border-color .2s, box-shadow .2s;
}
input:focus, textarea:focus, select:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 2px rgba(0,212,255,.12);
}
textarea { resize: vertical; min-height: 100px; }
select { cursor: pointer; }

/* Matrix rows */
.matrix-input { display: flex; flex-direction: column; gap: 4px; }
.row-inputs {
  display: flex;
  gap: 6px;
  align-items: center;
}
.row-inputs input { flex: 1; min-width: 0; }
.sep { color: var(--cyan); font-weight: 700; padding: 0 4px; flex-shrink: 0; }

/* ═══════════════ BUTTONS ═══════════════ */
.btn-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }

.btn-primary {
  padding: 9px 20px;
  background: linear-gradient(135deg, var(--purple), #5500cc);
  border: none;
  color: #fff;
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: .06em;
  border-radius: var(--radius);
  cursor: pointer;
  transition: all .2s;
  box-shadow: var(--glow-p);
}
.btn-primary:hover { filter: brightness(1.2); transform: translateY(-1px); }
.btn-primary:active { transform: none; }

.btn-ghost {
  padding: 9px 16px;
  background: transparent;
  border: 1px solid var(--orange);
  color: var(--orange);
  font-family: var(--font-mono);
  font-size: 12px;
  border-radius: var(--radius);
  cursor: pointer;
  transition: all .2s;
}
.btn-ghost:hover { background: rgba(255,107,53,.1); }

.btn-caso {
  padding: 10px 20px;
  background: linear-gradient(135deg, #006688, #00aad4);
  border: none;
  color: #fff;
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: .05em;
  border-radius: var(--radius);
  cursor: pointer;
  width: 100%;
  margin-top: 12px;
  transition: all .2s;
  box-shadow: 0 0 12px rgba(0,180,220,.3);
}
.btn-caso:hover { filter: brightness(1.15); transform: translateY(-1px); }

/* ═══════════════ RESULT BOX ═══════════════ */
.result-box {
  background: var(--bg);
  border: 1px solid var(--border);
  border-left: 3px solid var(--cyan);
  border-radius: var(--radius);
  padding: 12px 14px;
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.8;
  min-height: 60px;
  color: var(--text);
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 14px;
}
.result-box .ok { color: var(--green); }
.result-box .warn { color: var(--orange); }
.result-box .err { color: #ff4444; }
.result-box .hi { color: var(--cyan); font-weight: 700; }

/* ═══════════════ TABLES ═══════════════ */
.table-wrap { overflow-x: auto; }
table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-mono);
  font-size: 11px;
}
thead tr { background: rgba(0,212,255,.08); }
th {
  color: var(--cyan);
  text-transform: uppercase;
  letter-spacing: .08em;
  padding: 8px 10px;
  text-align: right;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
th:first-child { text-align: center; }
td {
  padding: 6px 10px;
  text-align: right;
  border-bottom: 1px solid rgba(30,46,74,.5);
  color: var(--text-dim);
}
td:first-child { text-align: center; color: var(--cyan); }
tr:hover td { background: rgba(255,255,255,.02); color: var(--text); }
tr.converged td { color: var(--green) !important; }

/* ═══════════════ CASOS ═══════════════ */
.casos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}

.caso-card {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-top: 3px solid var(--cyan);
  border-radius: 10px;
  padding: 20px;
}
.caso-card h3 {
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8px;
}
.caso-card p { color: var(--text-dim); font-size: 13px; }

.caso-num {
  font-family: var(--font-mono);
  font-size: 28px;
  font-weight: 700;
  color: rgba(0,212,255,.2);
  margin-bottom: 8px;
}

/* ═══════════════ STATUS BADGES ═══════════════ */
.status-stable { color: var(--green); }
.status-warn   { color: var(--orange); }
.status-crit   { color: #ff4444; }

/* ═══════════════ FOOTER ═══════════════ */
.site-footer {
  text-align: center;
  padding: 20px;
  border-top: 1px solid var(--border);
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .06em;
}


/* ═══════════════ BLOQUES EXPLICATIVOS PARA DEFENSA ═══════════════ */
.info-box{
  margin-top:15px;
  padding:15px;
  background: rgba(0,212,255,0.05);
  border: 1px solid rgba(0,212,255,0.15);
  border-left:4px solid var(--cyan);
  border-radius:8px;
  font-size:13px;
  line-height:1.7;
  color: var(--text);
}
.info-box h4{
  color: var(--cyan);
  margin-bottom:10px;
  font-size:13px;
  text-transform:uppercase;
  letter-spacing:.08em;
}
.info-box p{ margin-bottom:10px; color: var(--text); }
.info-box ul{ margin:8px 0 12px 18px; color: var(--text); }
.info-box li{ margin-bottom:6px; }
.method-grid{
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap:10px;
  margin-top:10px;
}
.method-pill{
  background: rgba(123,47,255,.08);
  border:1px solid rgba(123,47,255,.35);
  border-radius:8px;
  padding:10px;
}
.method-pill strong{ color:#b48fff; display:block; margin-bottom:4px; }
.defensa-note{
  background: rgba(255,107,53,.08);
  border-left-color: var(--orange);
}
.defensa-note h4{ color: var(--orange); }

/* ═══════════════ CANVAS ═══════════════ */
canvas { max-width: 100%; }

